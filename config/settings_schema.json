[
  {
    "name": "theme_info",
    "theme_name": "Loja Pro",
    "theme_version": "3.0.0",
    "theme_author": "Loja Clean",
    "theme_documentation_url": "https://help.shopify.com/pt-BR",
    "theme_support_url": "https://help.shopify.com/pt-BR"
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Cor de destaque (botões, preços e selos)",
        "default": "#5B2EFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Cor de fundo do site (branco) e texto dos botões de destaque",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_positive",
        "label": "Cor de Pix, frete e confirmações (verde)",
        "default": "#12805C"
      },
      {
        "type": "color",
        "id": "color_soft",
        "label": "Cor dos cartões e blocos",
        "default": "#F5F5F2"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Cor do texto, rodapé e faixas escuras",
        "default": "#14161A"
      }
    ]
  },
  {
    "name": "Estilo e layout",
    "settings": [
      {
        "type": "select",
        "id": "font_choice",
        "label": "Fonte do site",
        "options": [
          { "value": "inter", "label": "Inter (neutra e moderna)" },
          { "value": "poppins", "label": "Poppins (arredondada e jovem)" },
          { "value": "dm_sans", "label": "DM Sans (limpa e suave)" },
          { "value": "manrope", "label": "Manrope (elegante)" }
        ],
        "default": "inter"
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Arredondamento dos cantos (px)",
        "min": 0,
        "max": 24,
        "step": 2,
        "default": 10,
        "info": "0 deixa tudo reto; 24 deixa bem arredondado."
      },
      {
        "type": "select",
        "id": "grid_columns",
        "label": "Produtos por linha (computador)",
        "options": [
          { "value": "3", "label": "3 produtos" },
          { "value": "4", "label": "4 produtos" },
          { "value": "5", "label": "5 produtos" }
        ],
        "default": "4"
      },
      {
        "type": "range",
        "id": "container_width",
        "label": "Largura máxima do site (px)",
        "min": 1100,
        "max": 1900,
        "step": 50,
        "default": 1700,
        "info": "Em telas grandes, aumente para o site ocupar mais a largura."
      },
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Cabeçalho fixo ao rolar a página",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "Títulos em letras maiúsculas",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "gallery_sticky",
        "label": "Fotos do produto fixas ao rolar (computador)",
        "default": true
      }
    ]
  },
  {
    "name": "Logo e ícone",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (se vazio, usa o nome da loja em texto)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Ícone da aba do navegador (32 x 32 px)"
      }
    ]
  },
  {
    "name": "Pagamento e frete",
    "settings": [
      {
        "type": "paragraph",
        "content": "Estes valores só mudam o que aparece nos textos da loja. Os descontos e o frete reais são configurados no painel do Shopify (Descontos, Envio e entrega, Pagamentos)."
      },
      {
        "type": "range",
        "id": "pix_discount",
        "label": "Desconto no Pix (%)",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 5,
        "info": "Use 0 para não mostrar o preço no Pix."
      },
      {
        "type": "range",
        "id": "installments",
        "label": "Parcelas sem juros",
        "min": 1,
        "max": 12,
        "step": 1,
        "default": 3,
        "info": "Use 1 para não mostrar o parcelamento."
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Frete grátis acima de (R$)",
        "min": 0,
        "max": 1000,
        "step": 10,
        "default": 150,
        "info": "Use 0 para não mostrar a barra de frete grátis."
      }
    ]
  }
]
