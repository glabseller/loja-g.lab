<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign visual = settings.visual_style | default: 'modern' -%}
  {%- assign is_cartoon = false -%}
  {%- assign is_modern = false -%}
  {%- assign is_toon = false -%}
  {%- if visual == 'cartoon' -%}{%- assign is_cartoon = true -%}{%- elsif visual == 'classic' -%}{%- else -%}{%- assign is_modern = true -%}{%- endif -%}
  {%- if visual == 'toon' -%}{%- assign is_toon = true -%}{%- endif -%}
  {%- assign dark_mode = settings.dark_mode | default: 'auto' -%}
  {%- if is_toon -%}{%- assign dark_mode = 'light' -%}{%- endif -%}
  {%- case settings.font_choice -%}
    {%- when 'poppins' -%}{%- assign font_family = 'Poppins' -%}{%- assign font_query = 'Poppins:wght@400;500;600;700;800' -%}
    {%- when 'dm_sans' -%}{%- assign font_family = 'DM Sans' -%}{%- assign font_query = 'DM+Sans:wght@400;500;600;700' -%}
    {%- when 'manrope' -%}{%- assign font_family = 'Manrope' -%}{%- assign font_query = 'Manrope:wght@400;500;600;700;800' -%}
    {%- else -%}{%- assign font_family = 'Inter' -%}{%- assign font_query = 'Inter:wght@400;500;600;700;800' -%}
  {%- endcase -%}
  {%- assign font_head = font_family -%}
  {%- if is_toon -%}
    {%- assign font_family = 'Inter' -%}{%- assign font_head = 'Bricolage Grotesque' -%}
    {%- assign font_query = 'Inter:wght@400;500;600;700&family=Bricolage+Grotesque:wght@600;700;800' -%}
  {%- elsif is_modern -%}
    {%- assign font_family = 'Inter' -%}{%- assign font_head = 'Space Grotesk' -%}
    {%- assign font_query = 'Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700' -%}
  {%- elsif is_cartoon -%}
    {%- assign font_family = 'Nunito' -%}{%- assign font_head = 'Fredoka' -%}
    {%- assign font_query = 'Nunito:wght@500;600;700;800&family=Fredoka:wght@500;600;700' -%}
  {%- endif -%}
  <link href="https://fonts.googleapis.com/css2?family={{ font_query }}&display=swap" rel="stylesheet">

  {%- if is_modern -%}
  <script>
    (function () {
      var mode = {{ dark_mode | json }};
      var t = mode;
      try {
        if (mode === 'auto') {
          t = localStorage.getItem('theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        }
      } catch (e) { if (mode === 'auto') { t = 'light'; } }
      document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
    })();
  </script>
  <meta name="color-scheme" content="{% if dark_mode == 'dark' %}dark{% elsif dark_mode == 'light' %}light{% else %}light dark{% endif %}">
  {%- endif -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --accent: {{ settings.color_accent }};
      --ink: {{ settings.color_ink }};
      --positive: {{ settings.color_positive }};
      --soft: {{ settings.color_soft }};
      --accent-2: {{ settings.color_accent_2 | default: '#FF2E93' }};
      --text: {{ settings.color_text | default: '#14161A' }};
      --radius: {{ settings.corner_radius | default: 10 }}px;
      --container: {{ settings.container_width | default: 1700 }}px;
      --cols: {{ settings.grid_columns | default: 4 }};
      --accent-3: {{ settings.color_accent_3 | default: '#C6FF3D' }};
      --font-head: '{{ font_head }}', '{{ font_family }}', system-ui, sans-serif;
      --font: '{{ font_family }}', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }
  </style>

  <style>
    /* Barra de anúncio: estilo base (as opções da seção podem sobrescrever) */
    .announcement { background: #14161A; color: #FFFFFF; overflow: hidden; font-size: 13px; font-weight: 500; letter-spacing: .02em; }
    .announcement__track { display: flex; width: max-content; animation: announcement-marquee 28s linear infinite; }
    .announcement__group { display: flex; flex: 0 0 auto; min-width: 100vw; justify-content: space-around; }
    .announcement__item { display: block; padding: 9px 40px; white-space: nowrap; line-height: 1.2; }
    .announcement__item::after { content: "•"; margin-left: 72px; opacity: .5; }
    @keyframes announcement-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  </style>

  <script>
    window.themeConfig = {
      moneyFormat: {{ shop.money_format | json }},
      cartAddUrl: {{ routes.cart_add_url | append: '.js' | json }},
      cartUrl: {{ routes.cart_url | json }},
      cartJsUrl: {{ routes.cart_url | append: '.js' | json }},
      cartChangeUrl: {{ routes.cart_change_url | append: '.js' | json }}
    };
  </script>
</head>

<body class="template-{{ request.page_type | handleize }}{% if is_modern %} is-modern{% if is_toon %} is-toon{% endif %}{% elsif is_cartoon %} is-cartoon{% else %}{% if settings.colorful != false %} is-colorful{% endif %}{% if settings.glass != false %} is-glass{% endif %}{% endif %}{% if settings.header_sticky %} has-sticky-header{% endif %}{% if settings.heading_uppercase %} heading-upper{% endif %}{% if settings.gallery_sticky %} sticky-gallery{% endif %}{% if settings.mobile_bar != false %} has-mobile-bar{% endif %}{% if settings.reveal != false %} has-reveal{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

  {% section 'top-bar' %}
  {% section 'header' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- if settings.cart_drawer != false -%}{% render 'cart-drawer' %}{%- endif -%}
  {%- if settings.mobile_bar != false -%}{% render 'mobile-bar' %}{%- endif -%}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
