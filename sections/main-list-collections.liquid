<section class="page-pad container" {{ section.shopify_attributes }}>
  <h1 class="section-title" style="margin-bottom: 32px;">Categorias</h1>
  <div class="tiles">
    {%- for collection in collections -%}
      <a class="tile" href="{{ collection.url }}">
        <div class="tile__media">
          {% render 'media-or-placeholder', image: collection.featured_image, placeholder: 'collection-1', width: 400 %}
        </div>
        <span class="tile__name">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lista de categorias"
}
{% endschema %}
