<header class="site-header">
  <div class="container header__row">
    <a class="logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 320 | image_tag: alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <form class="header-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="header-search-input">Buscar</label>
      <input id="header-search-input" type="search" name="q" placeholder="Buscar produtos" value="{{ search.terms | escape }}">
      <button type="submit" aria-label="Buscar">{% render 'icon', name: 'search', size: 20 %}</button>
    </form>

    <div class="header__icons">
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Minha conta">{% render 'icon', name: 'user' %}</a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Carrinho">
        {% render 'icon', name: 'cart' %}
        {%- if cart.item_count > 0 -%}<span class="cart-badge">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>

  <div class="nav-bar">
    <div class="container nav-row">
    {%- assign menu = linklists[section.settings.menu] -%}
    <details class="cat-menu">
      <summary class="cat-menu__btn"><span class="cat-menu__icon" aria-hidden="true"></span>Categorias</summary>
      <div class="cat-panel">
        <div class="cat-panel__grid">
          {%- if menu.links.size > 0 -%}
            {%- for link in menu.links -%}
              <div class="cat-panel__col">
                <a class="cat-panel__title" href="{{ link.url }}">{{ link.title }}</a>
                {%- for child in link.links -%}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for c in collections limit: 40 -%}
              {%- if c.handle != 'frontpage' and c.handle != 'all' and c.products_count > 0 -%}
                <div class="cat-panel__col"><a class="cat-panel__title" href="{{ c.url }}">{{ c.title }}</a></div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </details>
    <nav class="nav" aria-label="Categorias">
      {%- assign menu = linklists[section.settings.menu] -%}
      {%- if menu.links.size > 0 -%}
      {%- for link in menu.links -%}
        <div class="nav__item{% if link.links.size > 0 %} nav__item--parent{% endif %}">
          <a href="{{ link.url }}"{% if section.settings.highlight_title != blank and link.title == section.settings.highlight_title %} class="nav__highlight"{% endif %}{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <div class="nav__sub">
              {%- for child in link.links -%}
                <div class="nav__item{% if child.links.size > 0 %} nav__item--parent{% endif %}">
                  <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>
                  {%- if child.links.size > 0 -%}
                    <div class="nav__sub">
                      {%- for grandchild in child.links -%}
                        <div class="nav__item"><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
      {%- else -%}
        {%- for c in collections limit: 12 -%}
          {%- if c.handle != 'frontpage' and c.handle != 'all' and c.products_count > 0 -%}
            <div class="nav__item"><a href="{{ c.url }}"{% if section.settings.highlight_title != blank and c.title == section.settings.highlight_title %} class="nav__highlight"{% endif %}>{{ c.title }}</a></div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>


    </div>
  </div>
</header>

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu de categorias", "info": "Crie em Conteúdo > Menus um menu chamado Categorias (com subcategorias). Se não existir, as coleções com produtos aparecem sozinhas.", "default": "categorias" },
    { "type": "text", "id": "highlight_title", "label": "Item do menu em destaque (nome igual ao do menu)", "default": "Ofertas" }
  ]
}
{% endschema %}
