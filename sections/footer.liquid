{%- assign wa_digits = section.settings.whatsapp | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', '' -%}
{%- assign mail = section.settings.email | default: shop.email -%}
<footer class="footer">
  <div class="container footer__row">
    <div class="footer__col footer__col--wide">
      <span class="footer__brand">{{ shop.name }}</span>
      {%- if section.settings.about != blank -%}<p class="footer__muted">{{ section.settings.about }}</p>{%- endif -%}
      <div class="footer__social">
        {%- if section.settings.instagram != blank -%}
          <a class="footer__soc" href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a class="footer__soc" href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2 4.2 5 4.5"/></svg></a>
        {%- endif -%}
        {%- if wa_digits != blank -%}
          <a class="footer__soc" href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 9c0 3 3 6 6 6l1.2-1.4-2-1-1 .7c-1-.4-1.9-1.3-2.3-2.300l.7-1-1-2z"/></svg></a>
        {%- endif -%}
        {%- if mail != blank -%}
          <a class="footer__soc" href="mailto:{{ mail }}" aria-label="E-mail"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/></svg></a>
        {%- endif -%}
      </div>
    </div>

    {%- assign shop_menu = linklists[section.settings.shop_menu] -%}
    {%- if shop_menu.links.size > 0 -%}
      <div class="footer__col">
        <span class="footer__heading">{{ section.settings.shop_heading }}</span>
        {%- for link in shop_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign menu = linklists[section.settings.menu] -%}
    {%- if menu.links.size > 0 -%}
      <div class="footer__col">
        <span class="footer__heading">{{ section.settings.menu_heading }}</span>
        {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign co_menu = linklists[section.settings.company_menu] -%}
    {%- if co_menu.links.size > 0 -%}
      <div class="footer__col">
        <span class="footer__heading">{{ section.settings.company_heading }}</span>
        {%- for link in co_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__col footer__col--contact">
      <span class="footer__heading">{{ section.settings.contact_heading }}</span>
      {%- if wa_digits != blank -%}<a href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener">WhatsApp: {{ section.settings.whatsapp }}</a>{%- endif -%}
      {%- if mail != blank -%}<a href="mailto:{{ mail }}">{{ mail }}</a>{%- endif -%}
      {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if section.settings.hours != blank -%}<span class="footer__muted">{{ section.settings.hours }}</span>{%- endif -%}
      {%- if section.settings.contact != blank -%}<div class="rte">{{ section.settings.contact }}</div>{%- endif -%}
    </div>
  </div>

  <div class="container footer__pay">
    <span class="footer__pill">Pix</span>
    <span class="footer__pill">Cartão de crédito</span>
    <span class="footer__pill">Compra 100% segura</span>
    <span class="footer__pill">Enviamos para todo o Brasil</span>
  </div>

  <div class="container footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos os direitos reservados.</span>
    <span>{{ section.settings.bottom_text }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    { "type": "textarea", "id": "about", "label": "Sobre a loja", "default": "Chaveiros, porta-latas, setup gamer, decoração e presentes feitos com carinho e atenção aos detalhes." },
    { "type": "header", "content": "Contato e redes (deixe vazio para esconder)" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (com DDD, ex.: 11 91234-5678)", "info": "Use o número com 55 na frente se preferir: 55 11 91234-5678" },
    { "type": "url", "id": "instagram", "label": "Link do Instagram" },
    { "type": "url", "id": "tiktok", "label": "Link do TikTok" },
    { "type": "text", "id": "email", "label": "E-mail de atendimento", "info": "Vazio = usa o e-mail da loja" },
    { "type": "text", "id": "hours", "label": "Horário de atendimento", "default": "Atendimento de segunda a sexta, 9h às 18h" },
    { "type": "header", "content": "Colunas" },
    { "type": "link_list", "id": "shop_menu", "label": "Menu: Loja", "default": "footer-loja" },
    { "type": "text", "id": "shop_heading", "label": "Título: Loja", "default": "Loja" },
    { "type": "link_list", "id": "menu", "label": "Menu: Ajuda", "default": "footer" },
    { "type": "text", "id": "menu_heading", "label": "Título: Ajuda", "default": "Ajuda" },
    { "type": "link_list", "id": "company_menu", "label": "Menu: Empresa", "default": "footer-empresa" },
    { "type": "text", "id": "company_heading", "label": "Título: Empresa", "default": "Institucional" },
    { "type": "text", "id": "contact_heading", "label": "Título do atendimento", "default": "Atendimento" },
    { "type": "richtext", "id": "contact", "label": "Texto extra do atendimento" },
    { "type": "text", "id": "bottom_text", "label": "Texto da base (ex.: CNPJ)" }
  ]
}
{% endschema %}
