<div data-recommendations data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&section_id={{ section.id }}&limit={{ section.settings.count }}&intent=related" {{ section.shopify_attributes }}>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section container recommendations">
      <div class="section-head"><h2 class="section-title">{{ section.settings.heading }}</h2></div>
      <div class="grid">
        {%- for rec in recommendations.products -%}
          {% render 'product-card', product: rec %}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Produtos relacionados",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Você também vai gostar" },
    { "type": "range", "id": "count", "label": "Quantidade", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Produtos relacionados" }]
}
{% endschema %}
