<section class="password" {{ section.shopify_attributes }}>
  <h1 class="section-title">{{ shop.name }}</h1>
  <p>Estamos preparando a loja. Volte em breve!</p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="Password">Senha</label>
      <input type="password" name="password" id="Password" autocomplete="current-password">
    </div>
    <button type="submit" class="btn btn--accent btn--lg btn--block">Entrar</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Página de senha"
}
{% endschema %}
