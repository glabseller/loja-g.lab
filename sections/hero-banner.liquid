{%- assign card = section.settings.product -%}
<section class="hero container hero--{{ section.settings.layout }}" {{ section.shopify_attributes }}>
  <div class="hero__panel">
    <div class="hero__text">
      {%- if section.settings.pill != blank -%}
        <span class="pill"><span class="pill__dot"></span>{{ section.settings.pill }}</span>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__lead">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_1_label != blank and section.settings.button_1_url != blank -%}
          <a class="btn btn--accent btn--lg" href="{{ section.settings.button_1_url }}">{{ section.settings.button_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank and section.settings.button_2_url != blank -%}
          <a class="btn btn--outline btn--lg" href="{{ section.settings.button_2_url }}">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.rating_text != blank -%}
        <div class="hero__rating"><span class="hero__rating-stars" aria-hidden="true">★★★★★</span><span>{{ section.settings.rating_text }}</span></div>
      {%- endif -%}
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '(min-width: 1280px) 600px, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
      {%- if card != blank -%}
        <a class="hero__card" href="{{ card.url }}">
          <span class="hero__card-img">
            {%- if card.featured_image != blank -%}{{ card.featured_image | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
          </span>
          <span class="hero__card-text">
            {%- if section.settings.card_tag != blank -%}<span class="hero__card-tag">{{ section.settings.card_tag }}</span>{%- endif -%}
            <span class="hero__card-name">{{ card.title | truncate: 28 }}</span>
            <span class="hero__card-price">{{ card.price | money }}</span>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Capa (banner principal)",
  "settings": [
    { "type": "select", "id": "layout", "label": "Posição da imagem", "options": [{ "value": "right", "label": "Imagem à direita" }, { "value": "left", "label": "Imagem à esquerda" }], "default": "right" },
    { "type": "text", "id": "pill", "label": "Selo acima do título", "default": "Novidades toda semana" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Os achados que estão bombando." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Produtos práticos e bonitos para o seu dia a dia, com envio para todo o Brasil." },
    { "type": "text", "id": "button_1_label", "label": "Botão 1: texto", "default": "Ver mais vendidos" },
    { "type": "url", "id": "button_1_url", "label": "Botão 1: link" },
    { "type": "text", "id": "button_2_label", "label": "Botão 2: texto", "default": "Ver ofertas" },
    { "type": "url", "id": "button_2_url", "label": "Botão 2: link" },
    { "type": "text", "id": "rating_text", "label": "Texto de avaliação (use só se for verdadeiro)", "info": "Ex.: 4,9 de nota média. Deixe vazio para não mostrar." },
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "product", "id": "product", "label": "Produto no cartão flutuante" },
    { "type": "text", "id": "card_tag", "label": "Etiqueta do cartão", "default": "MAIS VENDIDO" }
  ],
  "presets": [{ "name": "Capa (banner principal)" }]
}
{% endschema %}
