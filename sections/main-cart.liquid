{%- liquid
  assign free_cents = settings.free_shipping_threshold | times: 100
  assign progress = 0
  assign remaining = 0
  if free_cents > 0
    assign progress = cart.total_price | times: 100 | divided_by: free_cents
    if progress > 100
      assign progress = 100
    endif
    assign remaining = free_cents | minus: cart.total_price
  endif
-%}

<section class="page-pad container" {{ section.shopify_attributes }}>
  <h1 class="section-title" style="margin-bottom: 32px;">Carrinho</h1>

  {%- if cart.item_count == 0 -%}
    <div class="empty">
      <p>Seu carrinho está vazio.</p>
      <a class="btn btn--accent btn--lg" href="{{ routes.all_products_collection_url }}">Continuar comprando</a>
    </div>
  {%- else -%}

    {%- if free_cents > 0 -%}
      <div class="shipbar">
        <div class="shipbar__text">
          {%- if remaining > 0 -%}
            Faltam <strong>{{ remaining | money }}</strong> para você ganhar frete grátis
          {%- else -%}
            <strong>Você ganhou frete grátis!</strong>
          {%- endif -%}
        </div>
        <div class="shipbar__track"><div class="shipbar__fill" style="width: {{ progress }}%;"></div></div>
      </div>
    {%- endif -%}

    <form action="{{ routes.cart_url }}" method="post" class="cart__layout">
      <div class="cart__items">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a class="cart-item__img" href="{{ item.url }}">
              {%- if item.image != blank -%}
                {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </a>

            <div class="cart-item__main">
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <span class="cart-item__meta">{{ item.variant.title }}</span>
              {%- endunless -%}
              <span class="cart-item__meta">
                {{ item.final_price | money }}
                {%- if item.original_price > item.final_price %} <s>{{ item.original_price | money }}</s>{% endif -%}
              </span>
              {%- for allocation in item.line_level_discount_allocations -%}
                <span class="discount-line">{{ allocation.discount_application.title }}: -{{ allocation.amount | money }}</span>
              {%- endfor -%}

              <div class="cart-item__actions">
                <label class="visually-hidden" for="CartQty-{{ item.index }}">Quantidade de {{ item.product.title | escape }}</label>
                <input id="CartQty-{{ item.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-cart-qty>
                <a class="cart-item__remove" href="{{ item.url_to_remove }}">Remover</a>
              </div>
            </div>

            <div class="cart-item__total">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart__summary">
        <div class="summary-row"><span>Subtotal</span><span>{{ cart.original_total_price | money }}</span></div>
        {%- if cart.total_discount > 0 -%}
          <div class="summary-row discount-line"><span>Descontos</span><span>-{{ cart.total_discount | money }}</span></div>
        {%- endif -%}
        <div class="summary-row summary-row--total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>

        {%- if settings.pix_discount > 0 -%}
          {%- assign pix_factor = 100 | minus: settings.pix_discount -%}
          <p class="note">Pagando no Pix: <strong>{{ cart.total_price | times: pix_factor | divided_by: 100 | money }}</strong></p>
        {%- endif -%}
        <p class="note">O frete é calculado no checkout, depois que você informar o CEP.</p>

        <button type="submit" name="checkout" class="btn btn--accent btn--lg btn--block">Finalizar compra</button>
        <button type="submit" name="update" class="btn btn--outline btn--block">Atualizar carrinho</button>
        <a class="link-strong" style="text-align: center;" href="{{ routes.all_products_collection_url }}">Continuar comprando</a>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carrinho"
}
{% endschema %}
