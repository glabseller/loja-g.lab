{%- assign wa_raw = section.settings.whatsapp -%}
{%- assign wa = wa_raw | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', '' -%}
{%- assign mail = section.settings.email | default: shop.email -%}
<section class="page-pad container contact" {{ section.shopify_attributes }}>
  <h1 class="section-title">{{ page.title }}</h1>
  <p class="contact__lead">{{ section.settings.lead }}</p>

  <div class="contact__grid">
    <div class="contact__cards">
      {%- if wa != blank -%}
        <a class="contact__card" href="https://wa.me/{{ wa }}?text={{ 'Olá! Vim pelo site da G LAB e gostaria de ajuda.' | url_encode }}" target="_blank" rel="noopener">
          <span class="contact__ico contact__ico--wa"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 9c0 3 3 6 6 6l1.2-1.4-2-1-1 .7c-1-.4-1.9-1.3-2.3-2.3l.7-1-1-2z"/></svg></span>
          <span><strong>WhatsApp</strong><small>{{ wa_raw }} · resposta mais rápida</small></span>
        </a>
      {%- endif -%}
      {%- if mail != blank -%}
        <a class="contact__card" href="mailto:{{ mail }}">
          <span class="contact__ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/></svg></span>
          <span><strong>E-mail</strong><small>{{ mail }}</small></span>
        </a>
      {%- endif -%}
      {%- if section.settings.instagram != blank -%}
        <a class="contact__card" href="{{ section.settings.instagram }}" target="_blank" rel="noopener">
          <span class="contact__ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></span>
          <span><strong>Instagram</strong><small>Siga e mande uma mensagem</small></span>
        </a>
      {%- endif -%}
      {%- if section.settings.hours != blank -%}<p class="contact__hours">{{ section.settings.hours }}</p>{%- endif -%}
      <p class="contact__links"><a href="/pages/perguntas-frequentes">Perguntas frequentes</a> · <a href="/pages/trocas-e-devolucoes">Trocas e devoluções</a> · <a href="/pages/rastrear-pedido">Rastrear pedido</a></p>
    </div>

    <div class="contact__form">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact__ok" data-protocol-ok>Mensagem enviada! Seu protocolo: <strong data-protocol-code></strong>. Guarde esse número para falar com a gente. Respondemos o quanto antes.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="contact__err">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <input type="hidden" name="contact[protocolo]" value="">
        <label>Nome<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required></label>
        <label>E-mail<input type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required></label>
        <label>Telefone (opcional)<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
        <label>Mensagem<textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea></label>
        <button type="submit" class="btn btn--accent btn--lg btn--block">Enviar mensagem</button>
      {%- endform -%}
    </div>
  </div>
  {%- if page.content != blank -%}<div class="rte" style="margin-top:28px">{{ page.content }}</div>{%- endif -%}
</section>

{% schema %}
{
  "name": "Contato",
  "settings": [
    { "type": "textarea", "id": "lead", "label": "Texto de apresentação", "default": "Dúvida sobre um produto, pedido ou personalização? Fale com a gente pelo canal que preferir." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp", "default": "55 11 99651-6641" },
    { "type": "text", "id": "email", "label": "E-mail (vazio = e-mail da loja)" },
    { "type": "url", "id": "instagram", "label": "Link do Instagram" },
    { "type": "text", "id": "hours", "label": "Horário", "default": "Atendimento de segunda a sexta, 9h às 18h" }
  ]
}
{% endschema %}
