{%- assign free_cents = settings.free_shipping_threshold | times: 100 -%}
<div class="drawer" data-drawer data-free-cents="{{ free_cents }}" hidden>
  <div class="drawer__overlay" data-drawer-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title" tabindex="-1">
    <div class="drawer__head">
      <h2 class="drawer__title" id="drawer-title">Seu carrinho <span data-drawer-count></span></h2>
      <button type="button" class="icon-btn" data-drawer-close aria-label="Fechar carrinho">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__ship" data-drawer-ship hidden>
      <p class="drawer__ship-text" data-drawer-ship-text></p>
      <div class="shipbar__track"><div class="shipbar__fill" data-drawer-ship-fill style="width:0%"></div></div>
    </div>
    <div class="drawer__body" data-drawer-body></div>
    {% render 'cep-calc' %}
    <div class="drawer__xsell" data-drawer-xsell hidden></div>
    <div class="drawer__foot" data-drawer-foot hidden>
      <div class="summary-row summary-row--total"><span>Subtotal</span><span data-drawer-total></span></div>
      <p class="drawer__pix" data-drawer-pix hidden></p>
      <p class="note">Frete e descontos são calculados na finalização.</p>
      <a class="btn btn--accent btn--lg btn--block" href="{{ routes.cart_url }}/checkout" data-drawer-checkout>Finalizar compra</a>
      <a class="btn btn--block" href="{{ routes.cart_url }}">Ver carrinho</a>
    </div>
  </aside>
</div>
