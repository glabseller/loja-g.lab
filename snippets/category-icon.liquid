{%- comment -%}
  Desenho da categoria (quando não há foto).
  Parâmetro: key = texto com o nome ou o endereço da categoria (ex.: "Chaveiros", "porta-latas").
  Reconhece: chaveiro, lata, retrato/foto/polaroid, ampola, setup/gamer/game, casa/decor, presente, pet.
{%- endcomment -%}
{%- assign k = key | downcase -%}
{%- assign kind = 'caixa' -%}
{%- if k contains 'chave' -%}{%- assign kind = 'chaveiro' -%}
{%- elsif k contains 'lata' -%}{%- assign kind = 'lata' -%}
{%- elsif k contains 'retrato' or k contains 'foto' or k contains 'polaroid' -%}{%- assign kind = 'retrato' -%}
{%- elsif k contains 'ampola' or k contains 'frasco' -%}{%- assign kind = 'ampola' -%}
{%- elsif k contains 'setup' or k contains 'gamer' or k contains 'game' -%}{%- assign kind = 'gamer' -%}
{%- elsif k contains 'casa' or k contains 'decor' -%}{%- assign kind = 'casa' -%}
{%- elsif k contains 'present' -%}{%- assign kind = 'presente' -%}
{%- elsif k contains 'pet' or k contains 'cachorro' or k contains 'gato' -%}{%- assign kind = 'pet' -%}
{%- endif -%}
<svg class="cat-icon" viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true" focusable="false">
  {%- case kind -%}
    {%- when 'chaveiro' -%}
      <circle cx="48" cy="20" r="11"/>
      <circle cx="48" cy="20" r="4.5" stroke-opacity=".4"/>
      <path d="M48 31v9"/>
      <path d="M48 40c-12 0-22 4-22 12v22a8 8 0 0 0 8 8h28a8 8 0 0 0 8-8V52c0-8-10-12-22-12z" fill="var(--accent)" fill-opacity=".22"/>
      <circle cx="48" cy="54" r="5"/>
      <path d="M36 68h24M40 75h16" stroke-opacity=".55"/>
    {%- when 'lata' -%}
      <path d="M32 24h32l-2 54a6 6 0 0 1-6 6H40a6 6 0 0 1-6-6z" fill="var(--accent)" fill-opacity=".22"/>
      <path d="M32 24c0-5 7-8 16-8s16 3 16 8-7 8-16 8-16-3-16-8z" fill="#fff"/>
      <path d="M43 22h10" stroke-opacity=".6"/>
      <path d="M33 42h30M33.5 66h29" stroke-opacity=".5"/>
      <circle cx="48" cy="54" r="5" stroke-opacity=".5"/>
    {%- when 'retrato' -%}
      <rect x="22" y="14" width="52" height="62" rx="7" fill="var(--accent)" fill-opacity=".14"/>
      <rect x="30" y="22" width="36" height="40" rx="3" fill="#fff"/>
      <circle cx="42" cy="34" r="4"/>
      <path d="M30 56l12-12 8 8 6-6 10 10" />
      <path d="M36 76l-6 10M60 76l6 10"/>
    {%- when 'ampola' -%}
      <rect x="32" y="12" width="14" height="10" rx="3" fill="var(--accent)" fill-opacity=".3"/>
      <path d="M34 22v8l-5 6v36a6 6 0 0 0 6 6h6a6 6 0 0 0 6-6V36l-5-6v-8"/>
      <path d="M29 56h22" fill="none"/>
      <path d="M30 58v14a5 5 0 0 0 5 5h6a5 5 0 0 0 5-5V58z" fill="var(--accent)" fill-opacity=".3" stroke="none"/>
      <rect x="58" y="26" width="12" height="9" rx="3" fill="var(--accent)" fill-opacity=".3"/>
      <path d="M60 35v6l-4 5v28a5 5 0 0 0 5 5h4a5 5 0 0 0 5-5V46l-4-5v-6" stroke-opacity=".55"/>
    {%- when 'gamer' -%}
      <path d="M30 32h36c9 0 14 8 16 20l2 14c1 7-8 10-13 4L64 62H32l-7 8c-5 6-14 3-13-4l2-14c2-12 7-20 16-20z" fill="var(--accent)" fill-opacity=".18"/>
      <path d="M32 44v12M26 50h12"/>
      <circle cx="62" cy="46" r="2.5"/><circle cx="70" cy="52" r="2.5"/>
      <path d="M40 24c2-5 14-5 16 0" stroke-opacity=".5"/>
    {%- when 'casa' -%}
      <path d="M32 14h32l8 28H24z" fill="var(--accent)" fill-opacity=".22"/>
      <path d="M48 42v32"/>
      <path d="M34 82h28M48 74c-8 0-14 3-14 8M48 74c8 0 14 3 14 8" stroke-opacity=".0"/>
      <ellipse cx="48" cy="82" rx="16" ry="4"/>
      <path d="M40 30l-2 6M56 30l2 6" stroke-opacity=".45"/>
    {%- when 'presente' -%}
      <rect x="16" y="34" width="64" height="16" rx="4" fill="var(--accent)" fill-opacity=".22"/>
      <path d="M22 50v28a4 4 0 0 0 4 4h44a4 4 0 0 0 4-4V50"/>
      <path d="M48 34v48"/>
      <path d="M48 34c-4-14-20-16-20-8 0 6 12 8 20 8zM48 34c4-14 20-16 20-8 0 6-12 8-20 8z"/>
    {%- when 'pet' -%}
      <ellipse cx="48" cy="62" rx="20" ry="16" fill="var(--accent)" fill-opacity=".22"/>
      <ellipse cx="24" cy="42" rx="7" ry="9" transform="rotate(-20 24 42)"/>
      <ellipse cx="38" cy="26" rx="7" ry="10"/>
      <ellipse cx="58" cy="26" rx="7" ry="10"/>
      <ellipse cx="72" cy="42" rx="7" ry="9" transform="rotate(20 72 42)"/>
    {%- else -%}
      <path d="M48 12l32 16v40L48 84 16 68V28z" fill="var(--accent)" fill-opacity=".18"/>
      <path d="M16 28l32 16 32-16M48 44v40"/>
  {%- endcase -%}
</svg>
