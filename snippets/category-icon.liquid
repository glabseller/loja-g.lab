{%- comment -%}
  Desenho da categoria (quando não há foto).
  Parâmetro: key = texto com o nome ou o endereço da categoria (ex.: "Chaveiros", "porta-latas").
  Reconhece: chaveiro, lata, retrato/foto/polaroid, ampola, setup/gamer/game, casa/decor, presente, pet.
{%- endcomment -%}
{%- assign k = key | downcase -%}
{%- assign kind = 'caixa' -%}
{%- if k contains 'chave' -%}{%- assign kind = 'chaveiro' -%}
{%- elsif k contains 'lata' -%}{%- assign kind = 'lata' -%}
{%- elsif k contains 'retrato' or k contains 'foto' or k contains 'polaroid' -%}{%- assign kind = 'retrato' -%}
{%- elsif k contains 'ampola' or k contains 'frasco' -%}{%- assign kind = 'ampola' -%}
{%- elsif k contains 'setup' or k contains 'gamer' or k contains 'game' -%}{%- assign kind = 'gamer' -%}
{%- elsif k contains 'casa' or k contains 'decor' -%}{%- assign kind = 'casa' -%}
{%- elsif k contains 'present' -%}{%- assign kind = 'presente' -%}
{%- elsif k contains 'pet' or k contains 'cachorro' or k contains 'gato' -%}{%- assign kind = 'pet' -%}
{%- endif -%}
<svg class="cat-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true" focusable="false">
  {%- case kind -%}
    {%- when 'chaveiro' -%}
      <circle cx="32" cy="14" r="5"/>
      <rect x="20" y="26" width="24" height="26" rx="5"/>
    {%- when 'lata' -%}
      <path d="M22 14h20l-2 36H24z"/>
    {%- when 'retrato' -%}
      <rect x="16" y="12" width="32" height="40" rx="2"/>
      <rect x="22" y="18" width="20" height="20"/>
    {%- when 'ampola' -%}
      <path d="M28 12h8M30 12v12l-6 8v16h16V32l-6-8V12"/>
    {%- when 'gamer' -%}
      <rect x="10" y="22" width="44" height="22" rx="11"/>
      <path d="M22 29v8M18 33h8"/>
    {%- when 'casa' -%}
      <path d="M22 12h20l4 16H18z"/>
      <path d="M32 28v24M24 52h16"/>
    {%- when 'presente' -%}
      <rect x="12" y="26" width="40" height="26" rx="2"/>
      <path d="M12 34h40M32 26v26M32 26c-2-8-10-9-10-5s6 5 10 5zM32 26c2-8 10-9 10-5s-6 5-10 5z"/>
    {%- when 'pet' -%}
      <circle cx="32" cy="40" r="10"/>
      <circle cx="18" cy="28" r="3"/><circle cx="28" cy="18" r="3"/><circle cx="38" cy="18" r="3"/><circle cx="48" cy="28" r="3"/>
    {%- else -%}
      <path d="M32 10l20 10v24L32 54 12 44V20z"/>
      <path d="M12 20l20 10 20-10M32 30v24"/>
  {%- endcase -%}
</svg>
