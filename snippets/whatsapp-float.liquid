{%- assign wa_digits = settings.whatsapp_number | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', '' -%}
{%- if wa_digits != blank -%}
  <a class="wa-float" href="https://wa.me/{{ wa_digits }}?text={{ settings.whatsapp_greeting | default: 'Olá!' | url_encode }}" target="_blank" rel="noopener" aria-label="Falar com a gente no WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 9c0 3 3 6 6 6l1.2-1.4-2-1-1 .7c-1-.4-1.9-1.3-2.3-2.3l.7-1-1-2z"/></svg>
    <span class="wa-float__label">Fale com a gente</span>
  </a>
{%- endif -%}
