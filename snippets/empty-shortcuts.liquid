{%- comment -%} Atalhos para o cliente não ficar num beco sem saída: categorias do menu + WhatsApp. {%- endcomment -%}
{%- assign es_wa = settings.whatsapp_number | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', '' -%}
<div class="shortcuts">
  {%- assign es_count = 0 -%}
  {%- capture es_chips -%}
    {%- for c in collections -%}
      {%- unless c.title contains ' - ' -%}
        {%- if c.all_products_count > 0 and c.handle != 'frontpage' and c.handle != 'all' and es_count < 8 -%}
          {%- assign es_count = es_count | plus: 1 -%}
          <a class="shortcuts__chip" href="{{ c.url }}">{{ c.title }}</a>
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if es_chips contains 'shortcuts__chip' -%}
    <p class="shortcuts__title">Explore por categoria</p>
    <div class="shortcuts__chips">{{ es_chips }}</div>
  {%- endif -%}
  {%- if es_wa != blank -%}
    <a class="shortcuts__wa" href="https://wa.me/{{ es_wa }}?text={{ 'Olá! Preciso de ajuda para encontrar um produto.' | url_encode }}" target="_blank" rel="noopener">Não achou? Chame a gente no WhatsApp</a>
  {%- endif -%}
</div>
